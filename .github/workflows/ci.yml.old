name: CI

on:
  push:
  pull_request:
  workflow_call:

permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always

jobs:
  prepare:
    # Equivalent to the GitLab workflow rule excluding release commits.
    if: >-
      !(github.event_name == 'push' &&
        github.ref == format('refs/heads/{0}', github.event.repository.default_branch) &&
        startsWith(github.event.head_commit.message, 'chore(release)'))
    runs-on: ubuntu-latest
    outputs:
      components: ${{ steps.changes.outputs.components }}
      builds: ${{ steps.changes.outputs.builds }}
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - name: Select changed components
        id: changes
        shell: bash
        env:
          EVENT_NAME: ${{ github.event_name }}
          REF_TYPE: ${{ github.ref_type }}
          BEFORE_SHA: ${{ github.event.before }}
          HEAD_SHA: ${{ github.sha }}
          PR_BASE_SHA: ${{ github.event.pull_request.base.sha }}
          PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: bash scripts/ci/github-changes.sh

  quality:
    needs: prepare
    uses: ./.github/workflows/quality.yml

  units-test:
    needs: [prepare, quality]
    if: needs.prepare.outputs.components != '[]'
    uses: ./.github/workflows/units-test.yml
    with:
      components: ${{ needs.prepare.outputs.components }}

  build:
    needs: [prepare, quality, units-test]
    if: >-
      !cancelled() && needs.quality.result == 'success' &&
      (needs.units-test.result == 'success' || needs.units-test.result == 'skipped') &&
      needs.prepare.outputs.builds != '[]'
    uses: ./.github/workflows/build.yml
    with:
      builds: ${{ needs.prepare.outputs.builds }}
